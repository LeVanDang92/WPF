<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Factory Material Manager" Height="430" Width="430" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="FACTORY MATERIAL MANAGER" HorizontalAlignment="Center" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Đăng nhập hệ thống" Margin="0,8,0,24" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Tên đăng nhập:"/>
            <TextBox x:Name="UserNameTextBox" Height="34" Margin="0,5,0,14"/>
            <TextBlock Text="Mật khẩu:"/>
            <PasswordBox x:Name="PasswordBox" Height="34" Margin="0,5,0,8"/>
            <CheckBox x:Name="RememberMeCheckBox" Content="Ghi nhớ đăng nhập" Margin="0,0,0,14"/>
            <TextBlock x:Name="ErrorTextBlock" Foreground="Crimson" MinHeight="22"/>
            <Button Content="Đăng nhập" Width="100" Height="38" HorizontalAlignment="Center" Click="LoginButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
