<UserControl
    x:Class="WarehouseManager.Presentation.Wpf.Views.MaterialsView"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <BooleanToVisibilityConverter
            x:Key="BoolToVisibilityConverter" />

    </UserControl.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>


        <!-- Title -->

        <TextBlock
            Text="{Binding Title}"
            FontSize="26"
            FontWeight="SemiBold" />


        <!-- Search -->

        <StackPanel
            Grid.Row="1"
            Margin="0,18,0,12">

            <TextBlock
                Text="Search"
                FontWeight="SemiBold" />

            <TextBox
                Width="300"
                Height="34"
                HorizontalAlignment="Left"
                Margin="0,5,0,0"
                Text="{Binding SearchText,
                    UpdateSourceTrigger=PropertyChanged}" />

        </StackPanel>


        <!-- Edit form -->

        <Grid
            Grid.Row="2"
            Margin="0,0,0,12">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="160" />

                <ColumnDefinition Width="280" />

                <ColumnDefinition Width="120" />

                <ColumnDefinition Width="120" />

                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>


            <!-- Code -->

            <StackPanel
                Grid.Column="0"
                Margin="0,0,12,0">

                <TextBlock
                    Text="Code" />

                <TextBox
                    Height="34"
                    Margin="0,5,0,0"

                    IsReadOnly="{Binding IsEditing}"

                    Text="{Binding Code,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}" />

            </StackPanel>


            <!-- Name -->

            <StackPanel
                Grid.Column="1"
                Margin="0,0,12,0">

                <TextBlock
                    Text="Name" />

                <TextBox
                    Height="34"
                    Margin="0,5,0,0"

                    Text="{Binding Name,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}" />

            </StackPanel>


            <!-- Unit -->

            <StackPanel
                Grid.Column="2"
                Margin="0,0,12,0">

                <TextBlock
                    Text="Unit" />

                <ComboBox
                    Height="34"
                    Margin="0,5,0,0"

                    ItemsSource="{Binding Units}"

                    SelectedItem="{Binding Unit,
                        UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>


            <!-- Status -->

            <StackPanel
                Grid.Column="3">

                <TextBlock
                    Text="Active" />

                <CheckBox
                    Margin="0,12,0,0"
                    IsChecked="{Binding IsActive}"
                    IsEnabled="False" />

            </StackPanel>

        </Grid>


        <!-- Commands -->

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Margin="0,0,0,12">

            <Button
                Width="90"
                Height="34"
                Margin="0,0,8,0"
                Content="New"
                Command="{Binding NewCommand}" />

            <Button
                Width="90"
                Height="34"
                Margin="0,0,8,0"
                Content="Save"
                Command="{Binding SaveCommand}" />

            <Button
                Width="100"
                Height="34"
                Margin="0,0,8,0"
                Content="Deactivate"
                Command="{Binding DeactivateCommand}" />

            <Button
                Width="90"
                Height="34"
                Content="Reload"
                Command="{Binding LoadCommand}" />

        </StackPanel>


        <!-- Data -->

        <DataGrid
            Grid.Row="4"

            ItemsSource="{Binding MaterialItemsView}"

            SelectedItem="{Binding SelectedMaterial}"

            AutoGenerateColumns="False"

            IsReadOnly="True"

            SelectionMode="Single"

            SelectionUnit="FullRow"

            CanUserAddRows="False">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="Code"
                    Width="140"
                    Binding="{Binding Code}" />

                <DataGridTextColumn
                    Header="Name"
                    Width="*"
                    Binding="{Binding Name}" />

                <DataGridTextColumn
                    Header="Unit"
                    Width="100"
                    Binding="{Binding Unit}" />

                <DataGridCheckBoxColumn
                    Header="Active"
                    Width="100"
                    Binding="{Binding IsActive}" />

                <DataGridTextColumn
                    Header="Created"
                    Width="160"
                    Binding="{Binding CreatedAt,
                        StringFormat=yyyy-MM-dd HH:mm}" />

            </DataGrid.Columns>

        </DataGrid>


        <!-- Status -->

        <Grid
            Grid.Row="5"
            Margin="0,10,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    Text="{Binding StatusMessage}" />

                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Foreground="Crimson"
                    FontWeight="SemiBold" />

            </StackPanel>

            <ProgressBar
                Grid.Column="1"
                Width="160"
                Height="6"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy,
                    Converter={StaticResource BoolToVisibilityConverter}}" />

        </Grid>

    </Grid>

</UserControl>