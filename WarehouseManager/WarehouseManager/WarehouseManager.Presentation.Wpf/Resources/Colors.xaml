<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryColor">#1F3A5F</Color>
    <Color x:Key="SidebarColor">#172A46</Color>
    <Color x:Key="PageBackgroundColor">#172A46</Color>

    <SolidColorBrush
        x:Key="PrimaryBrush"
        Color="{StaticResource PrimaryColor}" />

    <SolidColorBrush
        x:Key="SidebarBrush"
        Color="{StaticResource SidebarColor}" />

    <SolidColorBrush
        x:Key="PageBackgroundBrush"
        Color="{StaticResource PageBackgroundColor}" />
</ResourceDictionary>